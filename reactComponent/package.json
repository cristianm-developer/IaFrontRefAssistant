{
  "name": "ia-front-ref-assistant",
  "version": "0.1.9",
  "description": "Widget visual (Preact embebido, cero dependencias de runtime) para asistir la codificación con IA — funciona en cualquier framework",
  "type": "module",
  "main": "./dist/ia-front-ref-assistant.cjs",
  "module": "./dist/ia-front-ref-assistant.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ia-front-ref-assistant.js",
      "require": "./dist/ia-front-ref-assistant.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs && node scripts/smoke-global.mjs",
    "example:install": "npm install --prefix example",
    "example:dev": "npm run dev --prefix example"
  },
  "keywords": [
    "react",
    "ai",
    "assistant",
    "component"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cristianm-developer/IaFrontRefAssistant.git",
    "directory": "reactComponent"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "preact": "^10.29.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.4"
  }
}
